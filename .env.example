# 复制为 .env 并填写。生成随机 token：
#   openssl rand -hex 32
OBSYNC_TOKEN=

# 可选：宿主机绑定地址与端口（默认 127.0.0.1:8080）
# OBSYNC_BIND=127.0.0.1
# OBSYNC_PORT=8080

# 可选：单文件大小上限（字节），默认 100MB
# OBSYNC_MAX_FILE_SIZE=104857600

# 可选：日志级别 debug/info/warn/error
# OBSYNC_LOG_LEVEL=info

# 可选：版本历史（默认开启，保留 90 天内最近 100 个版本/文件）
# OBSYNC_HISTORY_ENABLED=true
# OBSYNC_HISTORY_DAYS=90
# OBSYNC_HISTORY_MAX_PER_FILE=100
