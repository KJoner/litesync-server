# 复制为 .env 并填写。生成随机 token：
#   openssl rand -hex 32
OBSYNC_TOKEN=

# 可选：宿主机绑定地址与端口（默认 127.0.0.1:8080）
# OBSYNC_BIND=127.0.0.1
# OBSYNC_PORT=8080

# 可选：单文件大小上限（字节），默认 100MB
# OBSYNC_MAX_FILE_SIZE=104857600

# 可选：日志级别 debug/info/warn/error
# OBSYNC_LOG_LEVEL=info

# 可选：版本历史（默认开启）
# Markdown：90 天 / 100 版本（同时是三方合并的 merge-base，保守保留）
# 附件：30 天 / 10 版本（体积大，激进裁剪）
# OBSYNC_HISTORY_ENABLED=true
# OBSYNC_HISTORY_DAYS=90
# OBSYNC_HISTORY_MAX_PER_FILE=100
# OBSYNC_HISTORY_ATTACHMENT_DAYS=30
# OBSYNC_HISTORY_ATTACHMENT_MAX_PER_FILE=10

# 可选：非 HEAD 历史总字节硬上限（0 = 不限），如 2GB=2147483648
# OBSYNC_HISTORY_MAX_BYTES=0

# 可选：changes 变更日志保留（超出后旧游标客户端自动走 snapshot 对账）
# OBSYNC_CHANGES_DAYS=90
# OBSYNC_CHANGES_MAX=100000

# 可选：资源治理任务间隔小时（0 = 关闭；每次启动总会执行一次）
# OBSYNC_MAINTENANCE_HOURS=24

# 可选：备份配置密钥目录（宿主机路径，容器内挂载为 /etc/litesync 只读）。
# 一键部署脚本会在其中自动生成 backup-config.key（0600）。
# R2 凭据等备份 Secret 以该密钥 AES-256-GCM 加密后才写入数据库。
# LITESYNC_ETC_DIR=./etc-litesync
